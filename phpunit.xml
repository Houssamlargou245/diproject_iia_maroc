<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!-- Skipped unless DB_CONNECTION=mysql; see MysqlSchemaTest. -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Not `database`: the throttle tables do not exist before migrations
             run, and the OTP rate limiter would fail on every test. -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>

        <!-- The default test target is in-memory sqlite: fast, and no risk of
             a test truncating the development database. The schema is verified
             against the real MariaDB separately, see tests/Integration. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>

        <!-- The offline payment driver and no CMI credentials, so a live store
             key or transaction type in .env never reaches a test. A test that
             exercises the real driver sets its own throwaway values. -->
        <env name="PAYMENT_DRIVER" value="test"/>
        <env name="CMI_GATEWAY_URL" value="https://testpayment.cmi.co.ma/fim/est3Dgate"/>
        <env name="CMI_MERCHANT_ID" value=""/>
        <env name="CMI_STORE_KEY" value=""/>
        <env name="CMI_TRANS_TYPE" value="PreAuth"/>
    </php>
</phpunit>
