APP_NAME="ARABCIA 2026"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Casablanca
APP_URL=http://localhost:8000
# Comma-separated IPs or CIDR ranges of the reverse proxy in front of the app.
# Leave empty when there is no proxy: X-Forwarded-* is then ignored entirely, so
# a client cannot spoof the IP that the rate limits key on.
APP_TRUSTED_PROXIES=
# Turn on once TLS terminates in front of the app.
APP_FORCE_HTTPS=false

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: dedicated ARABCIA 2026 database (least-privilege user) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=arabcia_2026
DB_USERNAME=arabcia_2026
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in production; AppServiceProvider refuses to boot otherwise.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================================
# ARABCIA 2026 - Conference configuration
# ============================================================================
CONFERENCE_CODE=ARABCIA2026
CONFERENCE_YEAR=2026
# 300 delegates, from the 2026 brief.
CONFERENCE_CAPACITY=300
CONFERENCE_CURRENCY=MAD
CART_TTL_MINUTES=120
# Deferred to the end of the conference, per the brief.
SPEAKER_SUBMISSIONS_OPEN=false
PRESENTATION_UPLOADS_OPEN=false

# --- OTP delivery -----------------------------------------------------------
# Drivers: log | sms | telegram
#   log      development/CI only; refuses to run when APP_ENV=production
#   sms      costs money, no provider is free and unlimited
#   telegram free and effectively unlimited; the user must start the bot once
OTP_DRIVER=log
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_RATE_LIMIT_PER_PHONE=5

# --- SMS provider (used when OTP_DRIVER=sms) -------------------------------
# driver: twilio | vonage | infobip | generic
OTP_SMS_DRIVER=twilio
OTP_SMS_SID=
OTP_SMS_TOKEN=
OTP_SMS_FROM=
OTP_SMS_BASE_URL=
OTP_SMS_API_KEY=

# --- Authenticator app (TOTP) -----------------------------------------------
# How a delegate proves they can get back into their own account, replacing the
# SMS code that asked them to prove a phone number. Free and unlimited: the codes
# are computed on the visitor's phone, with no provider in the loop and no
# per-message charge.
#
# TOTP_REQUIRED=false lets an account that never enrolled place an order. It is
# on by default because an unenrolled account is the state the 2024 build left
# every account in, which is the gap this feature exists to close.
TOTP_REQUIRED=true
# Shown beside the entry in the authenticator app. Must be the brand they are
# registering for — a phone holding six conference codes is unreadable without it.
TOTP_ISSUER=ARABCIA 2026
TOTP_DIGITS=6
# 30-second steps accepted either side of now. One covers ordinary clock drift
# and the seconds spent reading the code; wider enlarges the replay window.
TOTP_WINDOW=1
TOTP_RECOVERY_CODES=8
TOTP_SECRET_BYTES=32
TOTP_MAX_ATTEMPTS=5
# Minutes the session may sit idle on the authenticator-app pages, which is
# where a visitor is most likely to put the phone down mid-flow.
TOTP_SESSION_LIFETIME=600

# --- Telegram (free, effectively unlimited) --------------------------------
OTP_TELEGRAM_BOT_TOKEN=
OTP_TELEGRAM_API_BASE=https://api.telegram.org
# Must equal the secret_token passed to setWebhook.
OTP_TELEGRAM_WEBHOOK_SECRET=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_OTP_IP=10
RATE_LIMIT_OTP_PHONE=5
RATE_LIMIT_LOGIN=5
RATE_LIMIT_CONTACT=3

# --- Payment: CMI e-Payment (3D Secure, PreAuth) ----------------------------
# Set PAYMENT_DRIVER=test to rehearse the full flow without a real card.
PAYMENT_DRIVER=test
CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate
# Test kit credentials authenticate only against the test host:
# CMI_GATEWAY_URL=https://testpayment.cmi.co.ma/fim/est3Dgate
CMI_MERCHANT_ID=
CMI_STORE_KEY=
CMI_STORE_TYPE=3D_PAY_HOSTING
CMI_TRANS_TYPE=PreAuth
# Payment-page session lifetime, 30-2700 seconds (CMI default 1800).
CMI_SESSION_TIMEOUT=1800
# Ask CMI to POST the server-to-server confirmation to callbackUrl.
CMI_CALLBACK_RESPONSE=true
# Return the customer straight to okUrl/failUrl instead of CMI's manual
# "retourner au site marchand" notification page.
CMI_AUTO_REDIRECT=true
CMI_CURRENCY_MAD=504
CMI_CURRENCY_USD=840
CMI_CURRENCY_EUR=978
# The contract settles in MAD only; other currencies are charged in MAD at
# these rates and shown to the customer via CMI's conversion display.
CMI_SETTLEMENT_CURRENCY=MAD
CMI_RATE_USD=10
CMI_RATE_EUR=11.1111
CMI_CALLBACK_DELAY_MINUTES=15
CMI_CALLBACK_DRIFT_SECONDS=300
CMI_INVOICE_PREFIX=ARABCIA-2026
CMI_TEST_MARKER=_test

# --- Payment rehearsal (admin-only gateway test) ---------------------------
# A single account may raise a real token order so the CMI round trip can be
# exercised end to end. Amounts are in minor units: 100 = 1,00 MAD, 9 = 0,09 €.
PAYMENT_TEST_USER=admin@arabcia.test
PAYMENT_TEST_AMOUNT=100
PAYMENT_TEST_AMOUNT_EUR=1500
PAYMENT_TEST_AMOUNT_HALF=50

# --- PDF / documents -------------------------------------------------------
PDF_PAPER=a4
PDF_ORIENTATION=portrait

# --- Legacy 2024 import (read-only source) ---------------------------------
# The same least-privilege account as DB_USERNAME: read access to the whitelisted
# 2024 tables only, and no write access to the legacy database.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=iiamaroc_new_db
LEGACY_DB_USERNAME=arabcia_2026
LEGACY_DB_PASSWORD=
